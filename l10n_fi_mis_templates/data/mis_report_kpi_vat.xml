        <field name="kpi_id" ref="kpi_arvonlisaveroilmoitus" />
        <field name="name">AccountingNone</field>
        <field name="sequence">0</field>
    </record>

    <record
        id="kpi_expression_vero_kotimaan_myynneista_verokannoittain"
        model="mis.report.kpi.expression"
    >
        <field name="kpi_id" ref="kpi_vero_kotimaan_myynneista_verokannoittain" />
        <field name="name">vero_25_5 + vero_13_5 + vero_10</field>
        <field name="sequence">0</field>
    </record>

    <record id="kpi_expression_vero_25_5" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_vero_25_5" />
        <field
            name="name"
        >-balp[][("tax_tag_ids.name", "=", "+fi_320")]-balp[][("tax_tag_ids.name", "=", "-fi_320")]</field>
        <field name="sequence">0</field>
    </record>

    <record id="kpi_expression_vero_13_5" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="kpi_vero_13_5" />
