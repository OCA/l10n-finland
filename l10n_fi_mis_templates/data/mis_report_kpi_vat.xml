            name="kpi_id"
            ref="kpi_vero_tavaroiden_maahantuonneista_eu_ulkopuolelta"
        />
        <field
            name="name"
        >+balp[][("tax_tag_ids.name", "=", "+fi_340")]+balp[][("tax_tag_ids.name", "=", "-fi_340")]</field>
