<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_apix_backend_form" model="ir.ui.view">
        <field name="name">apix.backend.form</field>
        <field name="model">apix.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_einvoice_fetch"
                        type="object"
                        class="oe_highlight"
                        string="Fetch invoices"
                        invisible="state != 'confirmed'"
                    />

                    <button
                        name="action_einvoice_refetch"
                        type="object"
                        class=""
                        string="Refetch invoices"
                        invisible="state != 'confirmed'"
                        confirm="Are you sure you want to refetch invoices? This will reprocess all previously fetched invoices and may result in duplicates."
                    />

                    <field name="state" widget="statusbar" />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            name="action_open_schedulers"
                            type="object"
                            icon="fa-clock-o"
                        >
                            <field
                                string="Schedulers"
                                name="scheduler_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>

                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" class="oe_inline" />
                    </h1>
                    <group name="configuration" groups="base.group_erp_manager">
                        <group name="odoo_configuration" string="Odoo configuration">
                            <field name="support_email" />
                            <field name="invoice_template_id" />
                        </group>

                        <group
                            name="apix_configuration"
                            string="APIX configuration"
                            groups="base.group_erp_manager"
                            readonly="state == 'confirmed'"
                        >
                            <field name="username" readonly="state == 'confirmed'" />
                            <field
                                name="password"
                                password="1"
                                readonly="state == 'confirmed'"
                            />
                            <field name="prefix" readonly="state == 'confirmed'" />
                            <field name="company_id" readonly="state == 'confirmed'" />
                            <field name="environment" readonly="state == 'confirmed'" />
                            <field name="debug" widget="boolean_toggle" />
                            <button
                                name="action_authenticate"
                                type="object"
                                class="btn btn-primary"
                                string="Authenticate"
                                invisible="state == 'confirmed'"
                            />

                            <button
                                name="action_reset_authentication"
                                type="object"
                                class="btn btn-danger"
                                string="Deauthenticate"
                                invisible="state != 'confirmed'"
                                confirm="Are you sure you want to revoke the authentication? This will require re-authentication."
                            />
                        </group>
                    </group>

                    <group name="apix_information">
                        <group name="apix_info" string="Customer information">
                            <field name="customer_id" invisible='1' />
                            <!-- This is identical with customer number -->
                            <field name="customer_number" />
                            <field name="contact_person" />
                            <field name="contact_email" />
                            <field name="owner_id" />
                        </group>

                        <group
                            name="apix_transfer"
                            string="Transfer information"
                            groups="base.group_system"
                            readonly="state == 'confirmed'"
                        >
                            <field name="transfer_id" />
                            <field name="transfer_key" />
                            <field name="company_uuid" />
                            <field name="business_id" />
                            <field name="id_qualifier" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
