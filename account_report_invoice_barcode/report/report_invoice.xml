<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="invoice_barcode_template" priority="99">
        <!-- The last-page class is only applied if report_qweb_element_page_visibility is installed -->
        <div
            id="barcode"
            t-if="o and o.barcode"
            class="row mt16 text-center last-page"
            style="height: 6rem; width: 500px; margin-left: -70px;"
        >
            <img
                t-att-src="'/report/barcode?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('Code128', o.barcode or '', 1600, 60)"
                class="col-12"
                style="width: 500px; height: 3rem; margin: auto; padding: 0; "
            />
            <span
                t-field="o.barcode"
                class="col-12"
                style="font-size: 12px; font-weight: bold; text-align: center; margin: auto; padding: 0;"
            />
        </div>
    </template>

    <template
        id="external_layout_standard_inherit"
        inherit_id="web.external_layout_standard"
        priority="99"
    >
        <xpath expr="//div[hasclass('o_footer_content')]" position="inside">
            <t t-if="o and o._name == 'account.move'">
                <t t-call="account_report_invoice_barcode.invoice_barcode_template" />
            </t>
        </xpath>
    </template>

    <template
        id="external_layout_bold_inherit"
        inherit_id="web.external_layout_bold"
        priority="99"
    >
        <xpath expr="//div[hasclass('o_footer_content')]" position="inside">
            <t t-call="account_report_invoice_barcode.invoice_barcode_template" />
        </xpath>
    </template>

    <template
        id="external_layout_boxed_inherit"
        inherit_id="web.external_layout_boxed"
        priority="99"
    >
        <xpath expr="//div[hasclass('o_footer_content')]" position="inside">
            <t t-call="account_report_invoice_barcode.invoice_barcode_template" />
        </xpath>
    </template>

    <template
        id="external_layout_striped_inherit"
        inherit_id="web.external_layout_striped"
        priority="99"
    >
        <xpath expr="//div[hasclass('o_footer_content')]" position="inside">
            <t t-call="account_report_invoice_barcode.invoice_barcode_template" />
        </xpath>
    </template>
</odoo>
