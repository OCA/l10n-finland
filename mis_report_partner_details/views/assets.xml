<?xml version="1.0" encoding="utf-8"?>
<odoo>
  
  <template id="mis_report_partner_details_template">
    <t t-call="web.html_container">
      <t t-set="head">
        <link rel="stylesheet" href="/mis_report_partner_details/static/src/css/mis_report_partner_details.css"/>
      </t>
      
      <div class="page">
        <div class="oe_structure"/>
        <t t-foreach="docs" t-as="doc">
          <div class="row">
            <div class="col-xs-12">
              <h2><t t-esc="doc.name"/></h2>
            </div>
          </div>
          <div class="row">
            <div class="col-xs-12">
              <table class="table table-condensed table-striped">
                <thead>
                  <tr>
                    <th><t t-esc="_('Description')"/></th>
                    <th><t t-esc="_('VAT Country')"/></th>
                    <th><t t-esc="_('VAT Number')"/></th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="o_mis_kpi_row">
                    <td class="o_mis_kpi_description"><t t-esc="kpi.description"/></td>
                    <td class="o_mis_kpi_vat_cc"><t t-esc="kpi.partner_vat_country or ''"/></td>
                    <td class="o_mis_kpi_vat"><t t-esc="kpi.partner_vat_number or kpi.partner_vat or ''"/></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </t>
      </div>
    </t>
  </template>
</odoo>