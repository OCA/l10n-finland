<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- FORM -->
    <record id="view_autocomplete_backend_form" model="ir.ui.view">
        <field name="name">autocomplete.backend.form</field>
        <field name="model">autocomplete.backend</field>
        <field name="arch" type="xml">
            <form string="Autocomplete Backend">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="name" />
                            <field name="name"/>
                        </h1>
                    </div>

                    <field name="company_id" groups="base.group_multi_company"/>

                    <group name="backend_config_settings">

                        <group name="country_settings" string="Country Settings">
                            <field name="available_country_ids" invisible="1"/>
                            <field name="default_country_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="is_country_active" widget="boolean_toggle"/>
                        </group>

                        <group name="environment_type" string="Environment Type">
                            <field name="country_environment_id" />
                            <field name="environment_type_code" invisible="1"/>
                            <field name="api_key" password="True" invisible="environment_type_code == 'free' or not environment_type_code" />
                        </group>

                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- TREE -->
    <record id="view_autocomplete_backend_tree" model="ir.ui.view">
        <field name="name">autocomplete.backend.tree</field>
        <field name="model">autocomplete.backend</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Autocomplete Backends">
                <field name="name"/>
                <field name="default_country_id"/>
                <field name="is_country_active"/>
                <field name="country_environment_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- MENU -->
    <record id="action_autocomplete_backend" model="ir.actions.act_window">
        <field name="name">Autocomplete Backends</field>
        <field name="res_model">autocomplete.backend</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_autocomplete_root"
        parent="connector.menu_connector_root"
        name="Autocomplete"
        sequence="10"
        groups="connector.group_connector_manager"
    />

    <menuitem
        id="menu_autocomplete_backend"
        name="Backends"
        parent="menu_autocomplete_root"
        action="action_autocomplete_backend"
    />
    
</odoo>