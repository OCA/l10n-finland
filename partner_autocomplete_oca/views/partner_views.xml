<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_partner_autocomplete_oca" model="ir.ui.view">
        <field name="name">view.partner.form.inherit.partner.autocomplete.oca</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@id='company']" position="attributes">
                <attribute name="widget">partner_autocomplete</attribute>
            </xpath>
        </field>
    </record>
</odoo>